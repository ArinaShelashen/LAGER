rule [
	labelType "term"
	left [
		node [ id 3 label "O" ]
		node [ id 9 label "P" ]
		edge [ source 3 target 16 label "-" ]
	]
	context [
		node [ id 1 label "C" ]
		node [ id 10 label "O" ]
		node [ id 11 label "C" ]
		node [ id 12 label "O" ]
		node [ id 13 label "C" ]
		node [ id 14 label "O" ]
		node [ id 15 label "C" ]
		node [ id 16 label "H" ]
		node [ id 17 label "O" ]
		edge [ source 14 target 9 label "-" ]
		edge [ source 15 target 14 label "-" ]
		edge [ source 13 target 12 label "-" ]
		edge [ source 12 target 9 label "-" ]
		edge [ source 1 target 17 label "=" ]
		edge [ source 9 target 10 label "-" ]
		edge [ source 10 target 11 label "-" ]
		edge [ source 3 target 1 label "-" ]
	]
	right [
		node [ id 3 label "O-" ]
		node [ id 9 label "P+" ]
		edge [ source 16 target 9 label "-" ]
	]
]