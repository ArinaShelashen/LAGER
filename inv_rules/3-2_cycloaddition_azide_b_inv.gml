rule [
	labelType "term"
	left [
		node [ id 12 label "N" ]
		node [ id 13 label "N" ]
		node [ id 14 label "N" ]
		node [ id 15 label "H" ]
		edge [ source 10 target 11 label ":" ]
		edge [ source 11 target 12 label ":" ]
		edge [ source 14 target 10 label ":" ]
		edge [ source 13 target 14 label ":" ]
		edge [ source 12 target 13 label ":" ]
		edge [ source 15 target 14 label "-" ]
	]
	context [
		node [ id 1 label "C" ]
		node [ id 11 label "C" ]
		node [ id 10 label "N" ]
		edge [ source 11 target 1 label "-" ]
	]
	right [
		node [ id 12 label "N-" ]
		node [ id 13 label "N+" ]
		node [ id 14 label "N-" ]
		node [ id 15 label "H+" ]
		edge [ source 10 target 11 label "#" ]
		edge [ source 13 target 14 label "=" ]
		edge [ source 12 target 13 label "=" ]
	]
]