rule [
	left [
		edge [ source 9 target 10 label "=" ]
		edge [ source 2 target 16 label "-" ]
		edge [ source 5 target 1 label "-" ]
		edge [ source 1 target 9 label "-" ]
		edge [ source 11 target 2 label "-" ]
	]
	context [
		node [ id 1 label "C" ]
		node [ id 2 label "O" ]
		node [ id 3 label "H" ]
		node [ id 4 label "H" ]
		node [ id 5 label "N" ]
		node [ id 9 label "P" ]
		node [ id 10 label "O" ]
		node [ id 11 label "C" ]
		node [ id 12 label "O" ]
		node [ id 13 label "C" ]
		node [ id 14 label "O" ]
		node [ id 15 label "C" ]
		node [ id 16 label "H" ]
		edge [ source 14 target 9 label "-" ]
		edge [ source 15 target 14 label "-" ]
		edge [ source 13 target 12 label "-" ]
		edge [ source 12 target 9 label "-" ]
		edge [ source 4 target 5 label "-" ]
		edge [ source 3 target 1 label "-" ]
	]
	right [
		edge [ source 9 target 10 label "-" ]
		edge [ source 5 target 16 label "-" ]
		edge [ source 1 target 2 label "=" ]
		edge [ source 10 target 11 label "-" ]
	]
]